generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("ADMIN")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductPlatform {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  description String?
  models      ProductModel[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ProductModel {
  id            String           @id @default(cuid())
  code          String           @unique
  name          String
  status        String           @default("ACTIVE")
  platformId    String
  platform      ProductPlatform  @relation(fields: [platformId], references: [id], onDelete: Cascade)
  frameMaterial String?
  wheelSize     String?
  motorPosition String?
  variants      ProductVariant[]
  vehicles      Vehicle[]
  bomItems      BomItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ProductVariant {
  id        String       @id @default(cuid())
  sku       String       @unique
  name      String
  edition   String?
  color     String?
  status    String       @default("ACTIVE")
  modelId   String
  model     ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Customer {
  id        String          @id @default(cuid())
  number    String          @unique
  type      String          @default("CONSUMER")
  name      String
  email     String?
  phone     String?
  country   String?
  vehicles  Vehicle[]
  tickets   ServiceTicket[]
  orders    Order[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Dealer {
  id        String   @id @default(cuid())
  number    String   @unique
  name      String
  country   String?
  city      String?
  email     String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id           String          @id @default(cuid())
  serialNumber String          @unique
  modelId      String
  model        ProductModel    @relation(fields: [modelId], references: [id])
  ownerId      String?
  owner        Customer?       @relation(fields: [ownerId], references: [id])
  activatedAt  DateTime?
  tickets      ServiceTicket[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Part {
  id                 String    @id @default(cuid())
  sku                String    @unique
  name               String
  category           String?
  manufacturerPartNo String?
  description        String?
  bomItems           BomItem[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model BomItem {
  id        String       @id @default(cuid())
  modelId   String
  model     ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  partId    String
  part      Part         @relation(fields: [partId], references: [id])
  quantity  Int          @default(1)
  position  String?
  callout   String?
  diagramX  Float?
  diagramY  Float?
  createdAt DateTime     @default(now())

  @@unique([modelId, partId])
}

model ServiceTicket {
  id          String    @id @default(cuid())
  number      String    @unique
  status      String    @default("OPEN")
  issue       String
  resolution  String?
  vehicleId   String?
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id])
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Order {
  id                String      @id @default(cuid())
  number            String      @unique
  channel           String
  paymentStatus     String      @default("PENDING")
  fulfillmentStatus String      @default("UNFULFILLED")
  customerId        String?
  customer          Customer?   @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku      String
  name     String
  quantity Int    @default(1)
}
